
# Required at build time for Google Maps on quotation/site/vendor maps.
# Without this key, maps fall back to OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Map ID for AdvancedMarkerElement (Cloud Console → Map Management).
# Defaults to DEMO_MAP_ID when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Public app origin used for pin links inside quotation PDF (NOT for drawing snapshots).
# Drawing snapshots load from NEXT_PUBLIC_API_URL / backend media.
NEXT_PUBLIC_FRONTEND_ADDRESS=http://localhost:3000
