# Backend API for jobs, clients, items, etc.
# You can keep pointing at the remote backend while material-request mock runs locally.
# NEXT_PUBLIC_API_URL=http://110.225.254.51:5050/api/v1
#
# Material request mock (Network tab): uses http://localhost:3000/api/v1/material-requests/
# automatically when MATERIAL_REQUEST_USE_MOCK=true in material-request.mock.config.ts

# Google Maps Platform — enable Places + Maps JavaScript API on this key.
# Restrict by HTTP referrer in Google Cloud Console. Do not commit the real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
