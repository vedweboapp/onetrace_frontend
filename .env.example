# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# Browser calls same-origin; Next.js proxies to BACKEND_API_ORIGIN (see next.config.ts).
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_API_ORIGIN=http://your-backend-host:5050

# Direct backend URL — only if frontend is not HTTPS or backend is HTTPS with CORS configured:
# NEXT_PUBLIC_API_URL=http://your-backend-host:5050/api/v1

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
