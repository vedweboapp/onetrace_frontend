# Copy to .env.local for local development (gitignored — not deployed).

# ── API — direct backend IP (recommended for local HTTP on port 3002) ────────
NEXT_PUBLIC_API_URL=http://110.225.254.51:5050/api/v1
BACKEND_API_ORIGIN=http://110.225.254.51:5050

# Optional proxy (only if you use https://localhost and need same-origin):
# NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_API_ORIGIN=http://110.225.254.51:5050

# Production deploy — set in hosting/CI:
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api/v1

# ── Mock APIs ──
# Rejection reason + user group use real APIs. Set to true only to force mock.
NEXT_PUBLIC_USER_GROUP_USE_MOCK=false
NEXT_PUBLIC_REJECTION_REASON_USE_MOCK=false

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FRONTEND_ADDRESS=http://localhost:3002

# ── Google Maps (optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
